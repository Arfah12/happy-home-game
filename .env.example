# Optional – cloud saving with Supabase.
# The game runs fully offline (LocalStorage) when these are left empty.
#
# Use the PUBLIC "anon" key only. NEVER put the service-role key in a VITE_ variable:
# everything prefixed with VITE_ is bundled into the browser build.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
